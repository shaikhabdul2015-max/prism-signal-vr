# Meta Llama 3.2 Server-Side Configuration
# LLAMA_API_KEY: Secret key for Llama 3.2 inference (strictly server-side, never exposed in client bundles)
LLAMA_API_KEY="your_secret_key"

# LLAMA_API_URL: Provider base endpoint (OpenAI SDK-compatible endpoint)
LLAMA_API_URL="https://api.groq.com/openai/v1"

# LLAMA_MODEL: Supported Meta Llama model identifier (e.g., llama-3.2-3b-preview, llama-3.2-11b-vision-preview, meta-llama/Llama-3.2-3B-Instruct)
LLAMA_MODEL="llama-3.2-3b-preview"

# Backwards-compatible aliases:
# GROQ_API_KEY="gsk_your_groq_api_key_here"
# GROQ_API_URL="https://api.groq.com/openai/v1"
# GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port on which the Express full-stack dev/production server listens (default: 3000)
PORT="3000"

# Firebase Client Configuration (Modular Web SDK)
# Obtain these credentials from your Firebase Console (Project Settings -> General -> Your apps)
# When omitted, the platform gracefully switches to enterprise local/offline persistence and simulated authentication
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Set to "true" to bypass active remote GCP connection checks and run with local enterprise persistence
VITE_FIREBASE_BYPASS_REMOTE="true"
